{
  "rewrites": [
    {
      "source": "/",
      "destination": "/manidental2.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "framework": null,
  "buildCommand": "node build.js",
  "outputDirectory": "dist"
}
